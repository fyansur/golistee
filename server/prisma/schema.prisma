generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  createdAt    DateTime           @default(now()) @db.Timestamptz
  accounts     PrintifyAccount[]
  blueprints   CuratedBlueprint[]
  designAssets DesignAsset[]
  templates    Template[]
}

model CuratedBlueprint {
  id          String   @id @default(cuid())
  userId      String
  blueprintId Int
  brand       String
  model       String
  title       String
  images      Json
  addedAt     DateTime @default(now()) @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PrintifyAccount {
  id          String    @id @default(cuid())
  userId      String
  label       String
  accessToken String
  tokenStatus String    @default("active")
  connectedAt DateTime  @default(now()) @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id])
  shops       Shop[]
  images      PrintifyImage[]

  @@index([userId])
}

model Shop {
  id                String          @id @default(cuid())
  printifyAccountId String
  printifyShopId    String
  title             String
  salesChannel      String
  status            String          @default("active")
  enabled           Boolean         @default(true)
  account           PrintifyAccount @relation(fields: [printifyAccountId], references: [id])
  listings          Listing[]

  @@index([printifyAccountId])
  @@unique([printifyAccountId, printifyShopId])
}

model Template {
  id                 String          @id @default(cuid())
  userId             String
  name               String
  blueprintId        Int
  blueprintLabel     String
  printProviderId    Int
  printProviderLabel String
  variants           Json
  description        String          @default("")
  user               User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PublishBatch {
  id        String    @id @default(cuid())
  userId    String
  shopIds   String[]
  total     Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz
  listings  Listing[]

  @@index([userId])
}

model Listing {
  id                 String          @id @default(cuid())
  batchId            String
  shopId             String
  blueprintId        Int
  blueprintLabel     String
  printProviderId    Int
  printProviderLabel String
  title              String
  description        String          @default("")
  tags               String[]
  variants           Json
  status             String          @default("draft")
  errorMessage       String?
  printifyProductId  String?
  lastPublishedAt    DateTime?       @db.Timestamptz
  createdAt          DateTime        @default(now()) @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @db.Timestamptz
  batch              PublishBatch    @relation(fields: [batchId], references: [id])
  shop               Shop            @relation(fields: [shopId], references: [id])
  designs            ListingDesign[]

  @@index([batchId])
  @@index([shopId])
}

model ListingDesign {
  id              String   @id @default(cuid())
  listingId       String
  position        String?
  variantIds      Int[]
  fileUrl         String
  thumbUrl        String?
  printifyImageId String?
  localBackupPath String?
  x               Float    @default(0.5)
  y               Float    @default(0.5)
  scale           Float    @default(1)
  angle           Float    @default(0)
  uploadStatus    String   @default("uploading")
  uploadError     String?
  listing         Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId])
}

// Display-name override + archived flag for a file in the "My files" library.
// Keyed by fileUrl rather than owning the upload itself — the underlying R2
// object and any ListingDesign rows pointing at it are untouched by a rename
// or archive here.
// thumbUrl/printifyImageId are only populated for a file uploaded straight
// from "My files" (never placed on any listing) — there's no ListingDesign
// row to source them from otherwise, so this is the only place they'd live.
model DesignAsset {
  id              String  @id @default(cuid())
  userId          String
  fileUrl         String
  name            String?
  archived        Boolean @default(false)
  thumbUrl        String?
  printifyImageId String?
  user            User    @relation(fields: [userId], references: [id])

  @@unique([userId, fileUrl])
}

// Image IDs are scoped to the Printify account, not globally reusable files.
model PrintifyImage {
  printifyAccountId String
  fileUrl           String
  printifyImageId    String
  account           PrintifyAccount @relation(fields: [printifyAccountId], references: [id], onDelete: Cascade)

  @@id([printifyAccountId, fileUrl])
}

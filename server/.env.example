# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/golistee"

# Long random string used to sign auth JWTs
JWT_SECRET="generate-a-long-random-string"

# 32-byte key (base64) used to encrypt PrintifyAccount access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="generate-a-32-byte-base64-key"

# Public HTTPS origin and shared HMAC secret used for Printify order webhooks.
# Generate the secret with: openssl rand -hex 20
PUBLIC_BASE_URL="https://golistee.com"
PRINTIFY_WEBHOOK_SECRET="generate-a-random-webhook-secret"

PORT=3000

# Cloudflare R2 (design file storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# "development" enables verbose error responses (stack traces). Any other
# value (or unset) uses the safe, generic-error production posture.
NODE_ENV=development
